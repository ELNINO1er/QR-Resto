NODE_ENV=production
PORT=3001

# Obligatoire: une cle longue, unique par restaurant/installation.
# Exemple PowerShell pour generer: [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Max 256 }))
JWT_SECRET=remplacer-par-une-cle-longue-unique

# IP fixe locale du serveur restaurant. Les QR codes imprimes doivent pointer ici.
QR_BASE_URL=http://192.168.1.50:5173
CORS_ORIGINS=http://192.168.1.50:5173,http://192.168.1.50:3001

# Cote d'Ivoire = UTC+0
APP_TIME_ZONE=Africa/Abidjan

# Sauvegardes automatiques de la base locale actuelle
BACKUP_INTERVAL_HOURS=24
BACKUP_DIR=./backups

# Cible MySQL future
DB_CLIENT=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=qr_resto
MYSQL_USER=qr_resto_user
MYSQL_PASSWORD=changer-ce-mot-de-passe
